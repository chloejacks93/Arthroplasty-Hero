# Copy to server/.env for local development (never commit real values).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/asset_control_dev
DATABASE_SSL=false
PORT=3000
# Hours a recipient has to confirm receipt before a transfer is escalated
TRANSFER_ACCEPT_HOURS=24
# Tests only — must point at a disposable database whose name ends in _test
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/asset_control_test
