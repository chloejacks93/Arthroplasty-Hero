{
  "name": "arthroplasty-asset-control-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/migrate.js && node src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "create-admin": "node scripts/create-admin.js",
    "seed:dev": "node scripts/seed-dev.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
